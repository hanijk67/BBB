# پیکربندی نصب BigBlueButton برای LMS — کپی به .env و پر کردن مقادیر
# secretها را خالی گذاشته‌ایم؛ .env واقعی commit نشود.

# --- سرور BBB ---
# دامنه‌ی سرور BBB (رکورد A روی IP همین سرور؛ D4)
BBB_DOMAIN=class.glmp.ir
# IP عمومی سرور BBB (برای چک DNS در preflight؛ خالی = تشخیص خودکار)
BBB_PUBLIC_IP=
# ایمیل Let's Encrypt (برای هر دو سرور BBB و TURN)
BBB_LETSENCRYPT_EMAIL=
# سوییچ -v در bbb-install (README برنچ v4.0.x-release؛ D1 = 4.0)
BBB_VERSION=noble-400
# برنچ مخزن bbb-install که اسکریپت از آن دانلود می‌شود
BBB_INSTALL_BRANCH=v4.0.x-release
# shared secret API (openssl rand -hex 32) — همین مقدار در LMS هم ست می‌شود
BBB_SHARED_SECRET=

# --- ضبط (T7) ---
# کل /var/bigbluebutton با bind mount به این مسیر می‌رود (دیسک جدا)
BBB_RECORDINGS_DIR=/data/bigbluebutton
# فرمت‌های ضبط فعال (presentation همیشه؛ video اختیاری)
BBB_RECORDING_FORMATS=presentation,video
# خروجی H.264/mp4 در presentation برای iOS
BBB_VIDEO_MP4=true
# تعداد worker پردازش ضبط (اگر KeepEvents روشن است بیشتر از ۱ نشود)
BBB_RAP_WORKERS=1
# پاک‌سازی raw ضبط‌های منتشرشده بعد از N روز؛ published هرگز پاک نمی‌شود
BBB_RAW_RETENTION_DAYS=14

# --- زبان و کلاینت ---
# overrideLocale در bbb-html5.yml (خالی = زبان مرورگر؛ LMS در join هم زبان را می‌فرستد)
BBB_DEFAULT_LOCALE=fa-IR
# زبان fallback برای رشته‌های ترجمه‌نشده
BBB_FALLBACK_LOCALE=en
# سیاست مهمان: ALWAYS_ACCEPT | ALWAYS_DENY | ASK_MODERATOR
BBB_DEFAULT_GUEST_POLICY=ALWAYS_ACCEPT
# فقط اگر LMS روی IP خصوصی است (fetchUrlAllowedLocalHosts در bbb-web)؛ با کاما جدا
BBB_ALLOWED_CALLBACK_HOSTS=

# --- TURN جدا (T3) ---
# دامنه‌ی سرور TURN (رکورد A روی IP سرور TURN؛ D4)
BBB_TURN_HOST=turn.glmp.ir
# secret مشترک TURN: ۸ تا ۱۶ کاراکتر تصادفی (فقط حرف و عدد)؛ روی هر دو سرور یکی
BBB_TURN_SECRET=
# IP عمومی سرور TURN (خالی = تشخیص خودکار وقتی install-turn.sh روی خود سرور TURN اجرا می‌شود)
BBB_TURN_PUBLIC_IP=

# --- فونت و asset (T4/T5) ---
# فونت‌های فارسی روی host (برای LibreOffice تبدیل اسلاید)
BBB_FONTS_DIR=/usr/share/fonts/truetype/lms-fa
# مسیر URL برای CSS و فونت self-host روی nginx خود BBB
BBB_CUSTOM_ASSETS_URL=/lms-assets

# --- بکاپ و مانیتورینگ (فاز ۷؛ tools/backup.sh، tools/health-check.sh) ---
# مقصد rsync: مسیر محلی (/mnt/backup/bbb) یا user@host:/path (با کلید SSH بدون رمز)
BBB_BACKUP_DEST=
# raw هم بکاپ شود؟ (حجم زیاد؛ فقط برای rebuild ضبط لازم است)
BBB_BACKUP_INCLUDE_RAW=false
# گزینه‌های ssh برای rsync
BBB_BACKUP_SSH_OPTS="-o BatchMode=yes -o ConnectTimeout=20"
# آستانه‌ی هشدار: درصد پر بودن دیسک ضبط، load ۵ دقیقه به ازای هر هسته، تعداد ضبط منتظر پردازش
BBB_ALERT_DISK_PCT=85
BBB_ALERT_LOAD_PER_CPU=1.5
BBB_ALERT_RECORDING_QUEUE=10
# webhook اختیاری برای هشدار (POST با بدنه‌ی {"text": ...})
BBB_ALERT_WEBHOOK=

# --- شبکه ---
# mirror برای Docker Hub اگر بسته است (مثلاً https://mirror.example.ir)؛ خالی = بدون mirror
DOCKER_REGISTRY_MIRROR=
